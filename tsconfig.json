{
  "compileOnSave": true,
  "compilerOptions": {
    "allowJs": true,
    "target": "esnext",
    "module": "esnext",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "noEmitOnError": false,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "strictFunctionTypes": true,
    "removeComments": true,
    "preserveConstEnums": false,
    "sourceMap": false,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "strictNullChecks": true,
    "alwaysStrict": true,
    "moduleResolution": "bundler",
    "strict": true
  },
  "include": ["*.mjs", "src/**/*"]
}
